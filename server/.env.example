# 今天不低头 · 后端环境变量示例
# 复制为 server/.env 并填值。.env 已被 .gitignore 排除,key 绝不进 git。
# 注意:本零依赖服务不自动加载 .env,请用 `export $(cat .env|xargs) && npm start`,
#       或直接在命令行 export 后再 npm start。

# provider 选择:stub(默认,本地演示无需 key) | jd-gateway(接口确认后)
LLM_PROVIDER=stub

# 端口(默认 3000)
# PORT=3000

# —— 以下仅在 LLM_PROVIDER=jd-gateway 时需要,接口确认后填 ——
# JD_LLM_GATEWAY_URL=
# JD_LLM_GATEWAY_KEY=
# JD_LLM_MODEL=
